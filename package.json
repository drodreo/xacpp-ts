{
  "name": "xacpp",
  "version": "1.1.0",
  "description": "Agent Control Plane Protocol — TypeScript implementation",
  "keywords": [
    "xacpp",
    "acpp",
    "protocol",
    "communication",
    "peer"
  ],
  "author": "drodreo",
  "license": "MIT",
  "engines": {
    "node": ">=22.2.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build",
    "prepublishOnly": "rslib build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "bench:egress": "rslib build && node --experimental-strip-types examples/egress-bench.mts",
    "bench:protocol": "rslib build && node --experimental-strip-types examples/bench-protocol.mts"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rslib/core": "^0.21.5",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
